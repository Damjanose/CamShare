{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "pnpm": "10.0.0",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "pnpm": "10.0.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://camshare.uplisoft.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://camshare.uplisoft.com"
      },
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal"
    },
    "production": {
      "pnpm": "10.0.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://camshare.uplisoft.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://camshare.uplisoft.com"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "gpskosove@gmail.com",
        "ascAppId": "6772641876",
        "appleTeamId": "R72R8C56GK"
      }
    }
  }
}
