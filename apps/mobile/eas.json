{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "pnpm": "10.0.0",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "pnpm": "10.0.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://camshare.uplisoft.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://camshare.uplisoft.com"
      },
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal"
    },
    "production": {
      "pnpm": "10.0.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://camshare.uplisoft.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://camshare.uplisoft.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
