{
  "name": "camshare",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "bash scripts/setup-lan.sh && pnpm --filter @camshare/api --filter @camshare/client --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "mobile": "pnpm --filter mobile dev",
    "front": "pnpm --filter @camshare/client dev --host",
    "backend": "pnpm --filter @camshare/api dev",
    "start-mobile": "pnpm --filter @camshare/mobile dev"
  }
}
