{
  "name": "camshare",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "mobile": "pnpm --filter mobile dev",
    "start-front": "pnpm --filter @camshare/client dev",
    "start-back": "pnpm --filter @camshare/api dev",
    "start-mobile": "pnpm --filter @camshare/mobile dev"
  }
}
